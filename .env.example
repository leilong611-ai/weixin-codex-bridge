# Public template only. Do not put real tokens, cookies, QR codes, or account
# secrets in this file.
#
# The bridge does not load .env automatically. Export these values in your
# shell, terminal profile, process manager, or CI secret store.

# Codex workspace and runtime state.
CODEX_WEIXIN_CWD=<absolute-path-to-codex-workspace>
CODEX_WEIXIN_STATE_ROOT=<absolute-path-to-local-state-dir>
# Backward-compatible alias. If both roots are set, CODEX_WEIXIN_LOG_ROOT wins.
CODEX_WEIXIN_LOG_ROOT=
CODEX_HOME=<optional-absolute-path-to-codex-home>

# Weixin/OpenClaw account lookup. The bridge reads existing credentials from
# OPENCLAW_STATE_DIR/openclaw-weixin; it should not write credentials here.
OPENCLAW_STATE_DIR=<absolute-path-to-openclaw-state-dir>
OPENCLAW_CONFIG_PATH=<optional-absolute-path-to-openclaw-json>
CODEX_WEIXIN_ACCOUNT_ID=<optional-weixin-account-id>
CODEX_WEIXIN_CHANNEL_VERSION=2.1.1

# Delivery mode: desktop-ui uses Codex Desktop automation; codex-cli uses the
# Codex CLI directly. MAX_PARALLEL only applies to codex-cli; desktop-ui stays
# single-lane so multiple workers do not compete for one Codex window.
CODEX_WEIXIN_DELIVERY_MODE=desktop-ui
CODEX_WEIXIN_CLI_FALLBACK=false
CODEX_WEIXIN_MAX_PARALLEL=3

# Codex Desktop session and app overrides.
CODEX_WEIXIN_AUTO_DESKTOP_SESSION=true
CODEX_WEIXIN_SESSION_ID=
CODEX_DESKTOP_APP_ID=<optional-codex-desktop-windows-app-id>
CODEX_WEIXIN_DESKTOP_INPUT_SCRIPT=./scripts/Send-CodexDesktopInput.ps1
CODEX_WEIXIN_DESKTOP_MODEL_SCRIPT=./scripts/Set-CodexDesktopModel.ps1
CODEX_WEIXIN_DESKTOP_RESPONSE_TIMEOUT_MS=900000

# Codex CLI settings.
# Required for codex-cli and for CODEX_WEIXIN_CLI_FALLBACK=true.
# On macOS/Linux, leave this empty to discover `codex` from PATH.
# On Windows, the default is the npm-installed codex.cmd path.
CODEX_CMD_PATH=<optional-absolute-path-to-codex-command>
CODEX_WEIXIN_MODEL=gpt-5.4-mini

# ---- Security settings ----

# REQUIRED: comma-separated list of WeChat peer IDs that have owner access.
# At least one owner peer is required — the bridge will refuse to start if
# no owner is configured and ALLOW_UNCONFIGURED_DEV_MODE is not set.
CODEX_WEIXIN_OWNER_PEER_IDS=wxid_xxxxxxxx,another_wxid

# Optional: comma-separated list of WeChat peer IDs that can send normal
# messages to Codex but cannot use management commands.
CODEX_WEIXIN_ALLOWED_PEER_IDS=

# Optional: comma-separated list of WeChat peer IDs that can only query
# public bridge status (never trigger Codex execution).
CODEX_WEIXIN_READONLY_PEER_IDS=

# If true (default), any peer not in any of the above lists is rejected
# with a generic refusal. Set to false to allow unknown users.
CODEX_WEIXIN_DEFAULT_DENY=true

# Sandbox workspace for Codex execution. Codex will only run inside this
# directory tree. Set to an isolated directory — NEVER set to your home,
# .codex, .ssh, or OpenClaw state directory.
CODEX_WEIXIN_SANDBOX_ROOT=<absolute-path-to-sandbox>
# Optional: comma-separated list of allowed workspace roots.
CODEX_WEIXIN_ALLOWED_WORKSPACE_ROOTS=

# Execution mode: "restricted" (default) enforces workspace security checks.
# "high-risk" bypasses all workspace checks — only use in isolated environments.
CODEX_WEIXIN_EXECUTION_MODE=restricted

# Default: false. Set to true to allow --full-auto flag for Codex CLI.
# This gives Codex unrestricted filesystem and network access.
CODEX_WEIXIN_ALLOW_FULL_AUTO=false

# Default: false. Set to true to allow --skip-git-repo-check flag.
CODEX_WEIXIN_ALLOW_SKIP_GIT_CHECK=false

# Local console. Default: disabled.
CODEX_WEIXIN_CONSOLE_ENABLED=false
CODEX_WEIXIN_CONSOLE_PORT=18790
# Auto-generated if not set. Set a specific value for stable access.
CODEX_WEIXIN_CONSOLE_TOKEN=

# Allow bridge to start with no owner peer configured. ONLY use in isolated
# development environments where no real WeChat users are connected.
CODEX_WEIXIN_ALLOW_UNCONFIGURED_DEV_MODE=false

# ---- Privacy and logging ----

# Log level: minimal (default), metadata, full-debug
#   minimal    — only message hash, session pseudonym, status, timestamps
#   metadata   — adds event counts and error categories
#   full-debug — stores full prompt text and Codex transcripts (DANGEROUS)
CODEX_WEIXIN_LOG_LEVEL=minimal
# Enable full Codex transcript storage. Default: false.
CODEX_WEIXIN_TRANSCRIPT_ENABLED=false
# Store full prompt text in failed tasks. Default: false.
CODEX_WEIXIN_STORE_FULL_PROMPTS=false
# Auto-delete data older than this many days. Default: 7.
CODEX_WEIXIN_DATA_RETENTION_DAYS=7

# ---- WeChat bot session ----

# Polling and startup behavior.
CODEX_WEIXIN_POLL_TIMEOUT_MS=35000
CODEX_WEIXIN_RESUME_ALL=true
CODEX_WEIXIN_RESUME_LAST=true
CODEX_WEIXIN_SKIP_BACKLOG_ON_START=true

# Optional desktop automation debug output. Keep this ignored and local.
CODEX_DESKTOP_INPUT_DEBUG_DIR=
