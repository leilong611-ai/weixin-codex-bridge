{
  "name": "weixin-codex-bridge",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Standalone Weixin to Codex bridge with security and reliability guards",
  "license": "MIT",
  "keywords": [
    "codex",
    "wechat",
    "weixin",
    "bridge",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leilong611-ai/weixin-codex-bridge.git"
  },
  "homepage": "https://github.com/leilong611-ai/weixin-codex-bridge#readme",
  "bugs": {
    "url": "https://github.com/leilong611-ai/weixin-codex-bridge/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "dist/cli.js",
  "bin": {
    "weixin-codex-bridge": "dist/cli.js"
  },
  "files": [
    ".env.example",
    "dist/",
    "docs/threat-model-walkthrough.md",
    "scripts/Install-CodexWeixinCompanionShortcut.ps1",
    "scripts/Launch-CodexWithWeixinBridge-Hidden.vbs",
    "scripts/Send-CodexDesktopInput.ps1",
    "scripts/Set-CodexDesktopModel.ps1",
    "scripts/Start-CodexWeixinBridge.ps1",
    "scripts/Start-CodexWithWeixinBridge.ps1",
    "scripts/Status-CodexWeixinBridge.ps1",
    "scripts/Test-CodexWeixinSetup.ps1",
    "scripts/Watch-CodexWeixinBridge.ps1",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "prestart": "npm run build",
    "test": "vitest",
    "validate:cli-only": "node scripts/validate-cli-only.mjs",
    "prelogin": "npm run build",
    "login": "node dist/cli.js login",
    "preaccounts": "npm run build",
    "accounts": "node dist/cli.js accounts",
    "prelogout": "npm run build",
    "logout": "node dist/cli.js logout",
    "predoctor": "npm run build",
    "doctor": "node dist/cli.js doctor",
    "setup-check": "powershell -ExecutionPolicy Bypass -File scripts/Test-CodexWeixinSetup.ps1",
    "public-check": "node scripts/public-check.mjs",
    "release:metadata": "node scripts/verify-release-metadata.mjs",
    "release:verify": "npm run release:metadata && npm run build && npm test -- --run && npm run public-check && npm run pack:verify",
    "prepublishOnly": "npm run release:verify",
    "pack:verify": "node scripts/verify-pack.mjs"
  },
  "dependencies": {
    "acpx": "0.3.1",
    "qrcode-terminal": "0.12.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
